#!/bin/bash
# Copyright © 2026 Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Initialize PostgreSQL database schema for Tuner v3.5
# Usage: initdb <workdir> [--recreate] [--force]
#
# Phase 2 (modularization unification, modular-tune.md §5 step 6): schema.sql
# is a FRESH schema, not a migration -- `optune_results`, `best_optune_results`
# and `most_accurate_optune_results` are gone outright, and `tuning_results` /
# `best_tuning_results` gained a `kernel_name`-incompatible column layout
# (`iface_name`/`impl_index`/`tuning_level` replace `kernel_name`/`hsaco_index`
# and `op_name`/`backend_index`). Applying this schema.sql against a workdir
# that still has the OLD pre-Phase-2 schema silently discards the ability to
# recompute best/most-accurate results from raw rows (see modular-tune.md's
# "Operational consequence, stated plainly" note). `--force` makes that
# discard a deliberate, explicit choice instead of an accident: initdb refuses
# to proceed if it detects the old schema's `tuning_results.kernel_name`
# column and `--force` was not given.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TUNE_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
AOTRITON_ROOT="$(cd "$TUNE_ROOT/.." && pwd)"

. "$TUNE_ROOT/lib/config_load.sh"

WORKDIR="$1"
shift || true

RECREATE_FLAG=""
FORCE_FLAG=""
for arg in "$@"; do
    case "$arg" in
        --recreate) RECREATE_FLAG="--recreate" ;;
        --force)    FORCE_FLAG="--force" ;;
        *)
            echo "Usage: $0 <workdir> [--recreate] [--force]" >&2
            echo "Error: unrecognized argument: $arg" >&2
            exit 1
            ;;
    esac
done

if [ -z "$WORKDIR" ]; then
    echo "Usage: $0 <workdir> [--recreate] [--force]" >&2
    exit 1
fi

load_config "$WORKDIR"

# Path to schema SQL file
SCHEMA_SQL="$AOTRITON_ROOT/python/tune/pq/schema.sql"

if [ ! -f "$SCHEMA_SQL" ]; then
    echo "Error: Schema file not found: $SCHEMA_SQL" >&2
    exit 1
fi

# Validate required config variables
if [ -z "$POSTGRES_USER" ] || [ -z "$POSTGRES_PASSWORD" ]; then
    echo "Error: POSTGRES_USER or POSTGRES_PASSWORD not set in config.rc" >&2
    exit 1
fi

if [ -z "$POSTGRES_DOCKER_IMAGE" ]; then
    echo "Error: POSTGRES_DOCKER_IMAGE not set in config.rc" >&2
    exit 1
fi

# Extract PostgreSQL version from POSTGRES_DOCKER_IMAGE (e.g., postgres:17.6 -> 17.6)
POSTGRES_VERSION=$(echo "$POSTGRES_DOCKER_IMAGE" | cut -d: -f2)

# Use matching psql docker image version
PSQL_IMAGE="alpine/psql:${POSTGRES_VERSION}"

# PostgreSQL connection parameters
# Default to localhost and standard port since containers use --network=host
POSTGRES_HOST="${CELERY_SERVICE_HOST:-localhost}"
POSTGRES_PORT="${POSTGRES_PORT:-5432}"

# Guard: refuse to run against a database that still has the OLD pre-Phase-2
# schema (detected via tuning_results.kernel_name, a column this fresh
# schema.sql no longer defines) unless --force is explicitly given. This is
# checked BEFORE --recreate's destructive DROP SCHEMA, so a stale database is
# never touched by accident. A local psql client is not assumed to be
# present, so the guard query reuses the same containerized PSQL_IMAGE as the
# rest of the script; if the database/table does not exist yet (first-ever
# initdb run) the query fails harmlessly and the guard is a no-op.
OLD_SCHEMA_CHECK=$(docker run --rm \
    --network=host \
    -e PGPASSWORD="$POSTGRES_PASSWORD" \
    "$PSQL_IMAGE" \
    postgresql://"$POSTGRES_USER"@"$POSTGRES_HOST":"$POSTGRES_PORT" \
    -t -A \
    -c "SELECT 1 FROM information_schema.columns WHERE table_name = 'tuning_results' AND column_name = 'kernel_name';" \
    2>/dev/null || true)

if [ "$(echo "$OLD_SCHEMA_CHECK" | tr -d '[:space:]')" = "1" ] && [ -z "$FORCE_FLAG" ]; then
    echo "Error: existing database still has the old pre-Phase-2 schema" >&2
    echo "       (tuning_results.kernel_name column found)." >&2
    echo "       This schema.sql is a fresh schema, not a migration:" >&2
    echo "       optune_results/best_optune_results/most_accurate_optune_results" >&2
    echo "       are dropped outright, and tuning_results/best_tuning_results are" >&2
    echo "       recreated with iface_name/impl_index/tuning_level columns." >&2
    echo "       Applying it discards all prior tuning results; re-tuning is" >&2
    echo "       required for every arch afterwards." >&2
    echo "" >&2
    echo "       Run '.tune/bin/export_best_results' first if you have not" >&2
    echo "       already exported centraldb.sqlite3 / op_database.sqlite3 --" >&2
    echo "       those artifacts are unaffected by this schema change." >&2
    echo "" >&2
    echo "       Re-run with --force once you have confirmed this is deliberate." >&2
    exit 1
fi

# Drop all tables if --recreate flag is set
if [ "$RECREATE_FLAG" = "--recreate" ]; then
    echo "WARNING: Recreating schema - dropping all tables first..."

    # Drop all tables in public schema
    docker run --rm \
        --network=host \
        -e PGPASSWORD="$POSTGRES_PASSWORD" \
        "$PSQL_IMAGE" \
        postgresql://"$POSTGRES_USER"@"$POSTGRES_HOST":"$POSTGRES_PORT" \
        -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public; GRANT ALL ON SCHEMA public TO $POSTGRES_USER; GRANT ALL ON SCHEMA public TO public;"

    if [ $? -ne 0 ]; then
        echo "Error: Failed to drop existing schema" >&2
        exit 1
    fi

    echo "All tables dropped successfully"
fi

echo "Initializing database schema..."
echo "Host: $POSTGRES_HOST"
echo "Port: $POSTGRES_PORT"
echo "User: $POSTGRES_USER"
echo "Using psql: $PSQL_IMAGE"

# Pull psql image if not present
echo "Pulling psql image: $PSQL_IMAGE"
docker pull "$PSQL_IMAGE"

# Execute schema SQL via containerized psql
# Mount schema file into container and execute it
docker run --rm \
    --network=host \
    -v "$SCHEMA_SQL:/schema.sql:ro" \
    -e PGPASSWORD="$POSTGRES_PASSWORD" \
    "$PSQL_IMAGE" \
    postgresql://"$POSTGRES_USER"@"$POSTGRES_HOST":"$POSTGRES_PORT" \
    -f /schema.sql

if [ $? -ne 0 ]; then
    echo "Error: Failed to initialize database schema" >&2
    exit 1
fi

echo "Database schema initialized successfully"

# Create partitions for all architectures in workers.db
echo "Creating partitions for architectures in workers.db..."
ARCHS=$(sqlite3 "$WORKDIR/workers.db" "SELECT DISTINCT arch FROM workers;" 2>/dev/null)

if [ -z "$ARCHS" ]; then
    echo "Warning: No workers found in workers.db, no partitions created"
else
    for ARCH in $ARCHS; do
        echo "Creating partition for architecture: $ARCH"
        docker run --rm \
            --network=host \
            -e PGPASSWORD="$POSTGRES_PASSWORD" \
            "$PSQL_IMAGE" \
            postgresql://"$POSTGRES_USER"@"$POSTGRES_HOST":"$POSTGRES_PORT" \
            -c "SELECT create_arch_partition('$ARCH');"

        if [ $? -eq 0 ]; then
            echo "  ✓ Partition task_queue_$ARCH created"
        else
            echo "  ✗ Failed to create partition for $ARCH" >&2
            exit 1
        fi
    done
    echo "All partitions created successfully"
fi
