# Run the testrun CLI tool inside the tuning Docker image.
#
# This is a thin wrapper: it starts the container and execs
# `aotriton.tune.testrun` inside it. ALL arguments are forwarded to
# `aotriton.tune.testrun` verbatim -- this script does not parse, consume, or
# reinterpret any of them.
#
#   testrun_direct [module] [--gpu GPU]
#
# The workdir is detected automatically from the script's location:
#   testrun_direct lives at  <workdir>/aotriton.src/.tune/remote/testrun_direct
#   so workdir is            <workdir>/aotriton.src/../.. resolved
#
# Docker image and connection parameters are read from <workdir>/config.rc.
# The container is removed automatically on exit (--rm).
#
# Which pyaotriton library build (tuning vs testing) the container sees is
# NOT this wrapper's concern: it inherits whatever PYTHONPATH is already set
# in the calling environment and passes it through unchanged. If PYTHONPATH
# is unset, the image/environment's own default applies. This wrapper makes
# no decision based on module name, GPU architecture, or any tuning-level
# flag -- that mapping belongs to whoever sets up the container (see
# .tune/single/start_worker.sh, which owns --tuning_mode for that reason).
#
# testrun is a REPL — commands are sent via stdin, not positional arguments.
#
# Examples:
#   # Show this wrapper's help
#   .tune/remote/testrun_direct -h
#   .tune/remote/testrun_direct --help
#
#   # Interactive session
#   .tune/remote/testrun_direct flash
#
#   # Run a specific entry non-interactively (pipe commands via stdin)
#   printf 'prepare_data dtype=float16;hdim=128;seqlen_q=4096;seqlen_k=4096;causal=False;dropout_p=0.0;bias_type=0 /tmp/myentry\n' \
#     | .tune/remote/testrun_direct flash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AOTRITON_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
WORKDIR="$(cd "$AOTRITON_ROOT/.." && pwd)"

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<EOF
Usage: $(basename "$0") [module] [--gpu GPU]

Run the aotriton.tune.testrun REPL inside the tuning Docker image.
Interface is identical to: python -m aotriton.tune.testrun -- this wrapper
forwards all arguments verbatim and consumes none of them itself.

GPU architecture is auto-detected via rocm_agent_enumerator (used only to
locate the container image / mount, not to pick a PYTHONPATH).

PYTHONPATH is inherited from the calling environment as-is (unset if not
already set there); this wrapper does not choose between the tuning and
testing library builds. That mapping is owned by whoever sets the container
up (see .tune/single/start_worker.sh's --tuning_mode).

Workdir auto-detected from script location:
  $WORKDIR

Config read from:
  $WORKDIR/config.rc

testrun is a REPL: commands are read from stdin, not passed as positional args.
Pipe commands in for non-interactive use.

Examples:
  # Interactive session
  $(basename "$0") flash

  # Run a specific entry non-interactively
  printf 'prepare_data dtype=float16;hdim=128;seqlen_q=4096;seqlen_k=4096;causal=False;dropout_p=0.0;bias_type=0 /tmp/myentry\n' \\
    | $(basename "$0") flash
EOF
    exit 0
fi

if [ ! -f "$WORKDIR/config.rc" ]; then
    echo "Error: config.rc not found at $WORKDIR/config.rc" >&2
    exit 1
fi

. "$WORKDIR/config.rc"

if [ -z "${CELERY_WORKER_IMAGE:-}" ]; then
    echo "Error: CELERY_WORKER_IMAGE not set in config.rc" >&2
    exit 1
fi

# Fail fast if no ROCm GPU is visible on this host. (The detected arch itself
# is not otherwise used -- this wrapper does not derive a PYTHONPATH from it.)
ARCH=$(rocm_agent_enumerator | grep -v gfx000 | head -1)
if [ -z "$ARCH" ]; then
    echo "Error: could not detect arch via rocm_agent_enumerator" >&2
    exit 1
fi

# PYTHONPATH is whatever the caller already has set (or unset) -- this
# wrapper does not compute one from $ARCH and a tuning level. Only forward it
# into the container if it is actually set in the environment.
PYTHONPATH_ARGS=()
if [ -n "${PYTHONPATH:-}" ]; then
    PYTHONPATH_ARGS=(-e "PYTHONPATH=$PYTHONPATH")
fi

exec docker run --rm -it \
    --device=/dev/kfd \
    --device=/dev/dri \
    --group-add video \
    --cap-add=SYS_PTRACE \
    --security-opt seccomp=unconfined \
    --ipc=host \
    --network=host \
    "${PYTHONPATH_ARGS[@]}" \
    -e PYTHONPYCACHEPREFIX=/wkdir/run/pycache \
    --mount type=bind,source="$(realpath "$WORKDIR")",target=/wkdir \
    "$CELERY_WORKER_IMAGE" \
    bash -l -c '
        source /wkdir/config.rc
        source "$(dirname "$CELERY_WORKER_PYTHON")/activate"
        cd /wkdir/aotriton.src
        exec "$CELERY_WORKER_PYTHON" -m aotriton.tune.testrun "$@"
    ' -- "$@"
