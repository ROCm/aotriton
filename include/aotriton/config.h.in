#ifndef AOTRITON_V2_CONFIG_H
#define AOTRITON_V2_CONFIG_H

#cmakedefine01 AOTRITON_ENABLE_SUFFIX

#if AOTRITON_ENABLE_SUFFIX
#cmakedefine AOTRITON_NAME_SUFFIX @AOTRITON_NAME_SUFFIX@
#define AOTRITON_NS aotriton@AOTRITON_NAME_SUFFIX@
#else
#define AOTRITON_NAME_SUFFIX
#define AOTRITON_NS aotriton
#endif

// Build the 0.11.x parameter-struct layout instead of the current one.
#cmakedefine01 AOTRITON_COMPAT_ABI_0_11

#cmakedefine AOTRITON_VERSION_MAJOR @AOTRITON_VERSION_MAJOR@
#cmakedefine AOTRITON_VERSION_MINOR @AOTRITON_VERSION_MINOR@
#cmakedefine AOTRITON_VERSION_PATCH @AOTRITON_VERSION_PATCH@
// Note the packaged SHA1 string may be different from the github release tag
// due to chicken-and-egg issue.
#cmakedefine AOTRITON_GIT_SHA1 @AOTRITON_GIT_SHA1@

#ifdef _MSC_VER
#define AOTRITON_API __declspec(dllexport)
#else
#define AOTRITON_API __attribute__ ((visibility ("default")))
#endif

#endif
