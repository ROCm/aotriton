#
# Builds the backend table of one subject (lib/common.h's kBackendNames): the
# canonical names of the backends of op_attn_fwd and op_attn_bwd, in the order
# of the index attn_options::force_backend_index takes.
#
# Two sources, because releases differ:
#   - runner/<tag>/backends.csv, written by hand, for the releases that publish
#     no list of their backends;
#   - the installed include/aotriton/flash/backends.h, for 0.14.2b and later.
#     Its X-macro rows are X(kConstant, "declared_name"), in index order.

# perfmon_flash_read_backends_csv(<csv> <fwd_var> <bwd_var>)
#
# Columns: iface,index,name[,enum_hint]. Lines starting with '#' and the header
# are skipped. The rows of one iface must be indexed 0, 1, 2, ... in order.
function(perfmon_flash_read_backends_csv csv fwd_var bwd_var)
  file(STRINGS "${csv}" _lines)
  set(_fwd "")
  set(_bwd "")
  set(_seen_header FALSE)
  foreach(_line IN LISTS _lines)
    string(STRIP "${_line}" _line)
    if(_line STREQUAL "" OR _line MATCHES "^#")
      continue()
    endif()
    string(REPLACE "," ";" _cols "${_line}")
    list(LENGTH _cols _ncols)
    if(NOT _seen_header)
      if(NOT _line MATCHES "^iface,index,name")
        message(FATAL_ERROR "[perfmon_flash] ${csv}: the header must start with iface,index,name; got '${_line}'")
      endif()
      set(_seen_header TRUE)
      continue()
    endif()
    if(_ncols LESS 3 OR _ncols GREATER 4)
      message(FATAL_ERROR "[perfmon_flash] ${csv}: expected iface,index,name[,enum_hint]; got '${_line}'")
    endif()
    list(GET _cols 0 _iface)
    list(GET _cols 1 _index)
    list(GET _cols 2 _name)
    if(NOT _name MATCHES "^[a-z0-9_]+$")
      message(FATAL_ERROR "[perfmon_flash] ${csv}: bad backend name '${_name}'")
    endif()
    if(_iface STREQUAL "op_attn_fwd")
      list(LENGTH _fwd _have)
      if(NOT _index EQUAL _have)
        message(FATAL_ERROR "[perfmon_flash] ${csv}: op_attn_fwd rows must be indexed 0,1,.. in order; got ${_index} after ${_have} rows")
      endif()
      list(APPEND _fwd "${_name}")
    elseif(_iface STREQUAL "op_attn_bwd")
      list(LENGTH _bwd _have)
      if(NOT _index EQUAL _have)
        message(FATAL_ERROR "[perfmon_flash] ${csv}: op_attn_bwd rows must be indexed 0,1,.. in order; got ${_index} after ${_have} rows")
      endif()
      list(APPEND _bwd "${_name}")
    else()
      message(FATAL_ERROR "[perfmon_flash] ${csv}: unknown iface '${_iface}'")
    endif()
  endforeach()
  if(NOT _seen_header)
    message(FATAL_ERROR "[perfmon_flash] ${csv}: no header line")
  endif()
  set(${fwd_var} "${_fwd}" PARENT_SCOPE)
  set(${bwd_var} "${_bwd}" PARENT_SCOPE)
endfunction()

# perfmon_flash_read_backends_header(<backends.h> <fwd_var> <bwd_var>)
#
# Reads the declared names out of
#   #define AOTRITON_BACKENDS_OpAttnFwdBackend(X) \
#     X(kTriton, "triton") \
#     X(kAiter, "aiter")
# The macro may span lines with trailing backslashes, as the generator writes it.
function(perfmon_flash_read_backends_header header fwd_var bwd_var)
  file(READ "${header}" _content)
  # Join the macro's backslash-continued lines.
  string(REPLACE "\\\n" " " _flat "${_content}")
  foreach(_which Fwd Bwd)
    set(_names "")
    string(REGEX MATCH "#define AOTRITON_BACKENDS_OpAttn${_which}Backend\\\(X\\\)[^\n]*" _def "${_flat}")
    string(REGEX MATCHALL "X\\\(k[A-Za-z0-9]+, *\"[a-z0-9_]+\"\\\)" _rows "${_def}")
    foreach(_row IN LISTS _rows)
      string(REGEX REPLACE "^X\\\(k[A-Za-z0-9]+, *\"([a-z0-9_]+)\"\\\)$" "\\1" _name "${_row}")
      list(APPEND _names "${_name}")
    endforeach()
    if(NOT _names)
      message(FATAL_ERROR "[perfmon_flash] ${header}: no AOTRITON_BACKENDS_OpAttn${_which}Backend rows. "
                          "The release's header changed shape, or this is not its backends.h.")
    endif()
    string(TOLOWER "${_which}" _lower)
    set(_${_lower} "${_names}")
  endforeach()
  set(${fwd_var} "${_fwd}" PARENT_SCOPE)
  set(${bwd_var} "${_bwd}" PARENT_SCOPE)
endfunction()

# perfmon_flash_write_backends_table(<out.cc> <fwd_names> <bwd_names>)
#
# The names are passed as lists by variable name. Writes, at configure time,
# the definition of perfmon_flash::kBackendNames.
function(perfmon_flash_write_backends_table out fwd_var bwd_var)
  set(fwd_names "${${fwd_var}}")
  set(bwd_names "${${bwd_var}}")
  set(_text "// Generated by GenerateBackends.cmake. Do not edit.\n")
  string(APPEND _text "#include \"common.h\"\n\nnamespace perfmon_flash {\n\nnamespace {\n")
  foreach(_which fwd bwd)
    set(_items "")
    foreach(_name IN LISTS ${_which}_names)
      string(APPEND _items "\"${_name}\", ")
    endforeach()
    list(LENGTH ${_which}_names _n_${_which})
    # A trailing nullptr keeps the array non-empty for a release with none.
    string(APPEND _text "const char* const ${_which}_names[] = {${_items}nullptr};\n")
  endforeach()
  string(APPEND _text "}  // namespace\n\n")
  string(APPEND _text "const BackendNames kBackendNames[kIfaceCount] = {\n")
  string(APPEND _text "    {fwd_names, ${_n_fwd}},\n    {bwd_names, ${_n_bwd}},\n};\n\n}  // namespace perfmon_flash\n")
  # Rewritten only on a change, so an unchanged table does not rebuild.
  set(_old "")
  if(EXISTS "${out}")
    file(READ "${out}" _old)
  endif()
  if(NOT _old STREQUAL _text)
    file(WRITE "${out}" "${_text}")
  endif()
endfunction()
