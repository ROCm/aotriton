#!/usr/bin/env -S python -m aotriton.database.interpreter
# Route the GR00T DiT backward cross-attention to the FlyDSL ("flyc") backend on
# gfx950 (MI355X).
#
# Functional 13 is bf16, BLOCK_DMODEL=64, CAUSAL_TYPE=0, ENABLE_DROPOUT=0,
# PADDED_HEAD=0, BIAS_TYPE=0 (.metadata/op_attn_bwd/functional.csv). PADDED_HEAD
# is not an operator-selection axis, so GR00T's native head_dim 48 (rounded to a
# padded BLOCK_DMODEL=64 by csrc/attn_bwd.cc, since flyc has no hd48 image) and
# head_dim 64 both resolve to this functional.
#
# DiT cross-attention is short-query / long-key (Max_seqlen_q~41 -> bucket 32/64,
# Max_seqlen_k=1024 -> bucket 1024, i.e. rows 1-2, column 6). The base tuning
# prefers aiter there; aiter cannot run the padded-head (hd48) case and resolves
# to triton_split instead. Measured on the freshly built gfx950 libaotriton
# (B=32 H=32 bf16, forced backends vs the auto pick):
#   cross-attn 41x1024 hd48 : auto=triton_split 653us  ->  flyc 434us  (1.51x)
#   cross-attn 41x1024 hd64 : auto=aiter        271us  ->  flyc 256us  (1.06x)
# flyc is correct (bf16-noise agreement with triton_split) at both.
#
# Precedence 14 = flyc (bord 4, most preferred) then triton_split (bord 1), a
# universal fallback that also covers the padded-head case flyc itself supports.
#! tuning keys
max_seqlen_q,16,32,64,128,256,512,1024,2048,4096,8192
max_seqlen_k,16,32,64,128,256,512,1024,2048,4096,8192
#! precedence
bits_per_slot,4
chars_per_slot,1
#! sparse tuning tensor
functional,precedence<-coordinates
13,
14<-1{6}2{6}
